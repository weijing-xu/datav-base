{
  "name": "@dv/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Framework-agnostic engine for data-screen effects: autofit layout, canvas decorations, tickers, theme tokens.",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles": {
      "types": "./src/styles/index.d.ts",
      "default": "./src/styles/index.css"
    }
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "^0.18.0",
    "typescript": "~5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/weijing-xu/datav-base.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "datav",
    "data-screen",
    "canvas-effects"
  ]
}
