{
  "name": "@dv/react",
  "version": "0.1.0",
  "type": "module",
  "description": "React 19 kit for data screens — thin wrappers over @dv/core.",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "echarts": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "dependencies": {
    "@dv/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "echarts": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.1",
    "tsdown": "^0.18.0",
    "typescript": "~5.9.3"
  }
}
